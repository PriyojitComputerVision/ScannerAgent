# Secrets: pass at runtime with --env-file .env, never bake into the image.
.env
*.env
!.env.example

# JWT signing keys: mount them at runtime (-v ./keys:/app/keys), never bake into the image.
keys
*.pem

# Local state and build artefacts
.git
.venv
venv
data
golden/results
logs
*.log
*.log.[0-9]*
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.vscode
.idea
.claude
