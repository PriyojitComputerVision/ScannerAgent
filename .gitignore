# --- Secrets / env ---
.env
*.env
!.env.example

# --- LLM prompt texts (kept private; loaded via pentest_agent/prompts.py) ---
prompts/

# --- Local-only assistant guide (not shared) ---
CLAUDE.md

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# --- uv / venv ---
.venv/
venv/
env/
uv.lock.bak
.python-version

# --- Test / lint / type caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Runtime data this project generates (reports, checkpoints) ---
# Recreated automatically at runtime (config.Settings.ensure_dirs / CLI --out).
data/

# NOTE: squid/allowed_target.acl is intentionally NOT ignored. It ships as a
# placeholder file in the repo (rewritten in place at runtime by
# docker_sandbox.write_squid_acl_for_target); Squid needs it to exist on
# first boot, so don't gitignore it even though its contents churn.

# --- Docker sandbox scratch workdirs (created under /tmp normally, but just in case) ---
sandbox/work/
*.tmp-work/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- LangSmith / local trace dumps, if any ---
.langsmith/

# --- API JWT signing keys (pentest-auth keys): never commit, especially the private key ---
keys/
*.pem

# --- Logs ---
# Warnings/errors file (LOG_FILE, default data/logs/pentest-agent.log) and its
# rotated backups (pentest-agent.log.1 ... .5).
*.log
*.log.[0-9]*
logs/
data/logs/
data/

# --- Golden-dataset drift reports (python -m pentest_agent.evals.golden) ---
# Only the results are ignored; golden/golden_dataset.json is tracked (tests,
# the drift check and the Docker image all need it).
golden/results/