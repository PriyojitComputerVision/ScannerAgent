---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	validate(validate)
	choose_scope(choose_scope)
	recon(recon)
	auth(auth)
	auth_challenge(auth_challenge)
	code_source(code_source)
	code_sast(code_sast)
	sandbox_check(sandbox_check)
	dast(dast)
	plan_probes(plan_probes<hr/><small><em>defer = True</em></small>)
	run_probes(run_probes)
	aggregate(aggregate)
	summarize(summarize)
	report(report)
	audit(audit)
	__end__([<p>__end__</p>]):::last
	__start__ --> validate;
	aggregate -.-> audit;
	aggregate -.-> summarize;
	audit -.-> __end__;
	auth -.-> aggregate;
	auth -.-> auth_challenge;
	auth -.-> code_source;
	auth_challenge -.-> aggregate;
	auth_challenge -.-> code_source;
	choose_scope -.-> aggregate;
	choose_scope -.-> auth;
	choose_scope -.-> recon;
	code_sast -.-> plan_probes;
	code_source -.-> aggregate;
	code_source -.-> code_sast;
	code_source -.-> dast;
	code_source -.-> sandbox_check;
	code_source -.-> sast\3arun_sast;
	dast -.-> plan_probes;
	plan_probes -.-> aggregate;
	plan_probes -.-> run_probes;
	recon -.-> aggregate;
	recon -.-> auth;
	report -.-> audit;
	run_probes -.-> aggregate;
	sandbox_check -.-> plan_probes;
	sast\3arun_sast --> plan_probes;
	summarize -.-> report;
	validate -.-> aggregate;
	validate -.-> audit;
	validate -.-> choose_scope;
	subgraph sast
	sast\3arun_sast(run_sast)
	end
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
