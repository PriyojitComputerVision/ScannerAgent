# ---- LLM (Groq) -- OPTIONAL: leave empty to run fully offline (no LLM) ----
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_RETRIES=5
# Output token cap per call (reasoning tokens count toward it).
GROQ_MAX_TOKENS=4096
# Max seconds one LLM call waits on Groq rate limits (HTTP 429) before that step
# uses its offline fallback; the WebSocket client gets a status message for every
# wait. LLM calls then pause until Groq's Retry-After has passed. 0 = never wait.
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=120
# gpt-oss models only: low / medium / high (empty = provider default).
GROQ_REASONING_EFFORT=low
# LLM-as-judge for the golden-dataset drift check (empty = same as GROQ_MODEL).
# A different model than the generator reduces self-preference bias.
GOLDEN_JUDGE_MODEL=

# ---- LangSmith tracing (optional) ----
# Traces every scan (graph nodes, tools, Groq calls, sandbox scan, probe runner,
# citation grounding) as one run. JWTs, passwords, cookies and API keys are
# redacted before upload (src/pentest_agent/tracing.py).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ENVIRONMENT=development

# ---- Storage ----
CHECKPOINT_DB_PATH=./data/checkpoints/main.sqlite
SUBAGENT_CHECKPOINT_DB_PATH=./data/checkpoints/subagents.sqlite
REPORTS_DIR=./data/reports

# ---- API authentication (JWT, RS256) + RBAC ----
# Every HTTP/WebSocket call except /healthz and /auth/* needs
# "Authorization: Bearer <access token>". Create the key pair once with
#   uv run pentest-auth keys          (or just run: uv run python scripts/get_token.py)
# keys/ is gitignored; never commit the private key. AUTH_ENABLED=false is for local testing only.
AUTH_ENABLED=true
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=pentest-agent
JWT_AUDIENCE=pentest-agent-api
# Access token lifetime; the server renews it automatically when less than
# JWT_AUTO_REFRESH_BEFORE_MINUTES is left (X-New-Access-Token header / "token_refreshed").
JWT_ACCESS_TTL_MINUTES=60
JWT_AUTO_REFRESH_BEFORE_MINUTES=10
# Max session length from sign-in (refresh tokens and auto refresh stop after this).
JWT_REFRESH_TTL_MINUTES=1440
JWT_LEEWAY_SECONDS=30
# Client that signs in at POST /auth/token. Generate a secret: uv run pentest-auth secret
AUTH_CLIENT_ID=pentest-client
AUTH_CLIENT_SECRET=
# RBAC roles of that client: viewer (read reports), scanner (+ run quick/standard scans),
# admin (+ aggressive/auth_deep, authenticated target testing, any session).
AUTH_CLIENT_ROLES=admin
# More clients with their own roles: uv run pentest-auth add-client --id NAME --roles scanner
AUTH_CLIENTS_FILE=./keys/clients.json

# ---- Logging ----
# Warnings and errors (with tracebacks) are also written to this rotating file
# (5 MB x 5 backups). Empty disables the file. Console output is unchanged.
LOG_FILE=./data/logs/pentest-agent.log
LOG_FILE_LEVEL=WARNING

# ---- Sandbox code & content check + agent safety ----
# Checks backend source + fetched website content in a Docker container
# (--network none, read-only, non-root). Pull the image once: python -m scopeguard.container --setup
# Check readiness with: python -m scopeguard.container --status
#   SANDBOX_USE_DOCKER=true  -> Docker when available; if Docker/the image is missing it runs in
#                               the Python process sandbox instead and the report gets a red flag.
#   SANDBOX_USE_DOCKER=false -> always the Python process sandbox (no Docker needed, no red flag).
#   SANDBOX_CHECK_ENABLED=false -> skip the code/content check entirely.
SANDBOX_CHECK_ENABLED=true
SANDBOX_USE_DOCKER=true
CODECHECK_IMAGE=python:3.12-slim
CODECHECK_TIMEOUT_SECONDS=180
CODECHECK_MEMORY_MB=512
# Folders a scan's "source_path" must sit inside (comma-separated; empty = any folder).
CODECHECK_SOURCE_ROOTS=
# Max times any agent node (and sub-agent) may run per scan (safety stop).
AGENT_MAX_ITERATIONS=5
# Active file-upload testing: POST benign, disguised marker files to detected upload
# forms (aggressive/auth_deep profile + admin scan:upload permission only).
ENABLE_UPLOAD_TESTS=true

# ---- Scan limits ----
MAX_CRAWL_PAGES=60

# ---- Caching ----
# Reuse identical scans, probe results and LLM answers for this many seconds (0 disables).
CACHE_TTL_SECONDS=300

# ---- LLM prompts ----
# Folder holding the prompt files (gitignored; see README "LLM prompts").
# Missing files make that LLM step fall back to its deterministic output.
PROMPTS_DIR=./prompts

# ---- Backend rate limit (per client IP; 0 disables) ----
# Exceeding it returns HTTP 429 with Retry-After.
HTTP_RATE_LIMIT_PER_MINUTE=120

# ---- API management: server-wide admission queues ----
# At most *_MAX_ACTIVE run at once (all clients together); up to *_MAX_QUEUE more
# wait in FIFO order; beyond that: 429 "Too many requests ... try again after some time"
# (WebSocket: error + close code 4429). Queued WebSocket clients get
# {"type": "queued", "position": n, ...} when their position changes and every
# QUEUE_UPDATE_SECONDS. HTTP responses carry X-Queue-Position / X-Queue-Wait-Seconds.
# GET /healthz shows the current counts. *_MAX_ACTIVE=0 disables that queue.
WS_MAX_ACTIVE=2
WS_MAX_QUEUE=50
HTTP_MAX_ACTIVE=2
HTTP_MAX_QUEUE=50
QUEUE_UPDATE_SECONDS=5
# Longest an HTTP request waits in the queue before it gets a 429.
HTTP_QUEUE_TIMEOUT_SECONDS=60

# ---- WebSocket server ----
WS_HOST=127.0.0.1
WS_PORT=8765
