# ---- LLM (Groq) -- OPTIONAL: leave empty to run fully offline (no LLM) ----
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_RETRIES=5
# Output token cap per call (reasoning tokens count toward it).
GROQ_MAX_TOKENS=4096
# Max seconds one LLM call waits on Groq rate limits (HTTP 429) before that step
# uses its offline fallback; the WebSocket client gets a status message for every
# wait. LLM calls then pause until Groq's Retry-After has passed. 0 = never wait.
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=120
# gpt-oss models only: low / medium / high (empty = provider default).
GROQ_REASONING_EFFORT=low
# LLM-as-judge for the golden-dataset drift check (empty = same as GROQ_MODEL).
# A different model than the generator reduces self-preference bias.
GOLDEN_JUDGE_MODEL=

# ---- LangSmith tracing (optional) ----
# Traces every scan (graph nodes, tools, Groq calls, sandbox scan, probe runner,
# citation grounding) as one run. JWTs, passwords, cookies and API keys are
# redacted before upload (src/pentest_agent/tracing.py).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Optional LangSmith agent address: with both set, runs go to this agent + environment
# instead of LANGSMITH_PROJECT (lower-case id, e.g. scopeguard-agent; environment e.g. local).
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Storage ----
CHECKPOINT_DB_PATH=./data/checkpoints/main.sqlite
# Several async writers share the checkpoint SQLite file (server, MCP / A2A scans; WAL mode):
# a writer that finds it locked waits up to this many seconds instead of failing.
CHECKPOINT_BUSY_TIMEOUT_SECONDS=30
# Delete scan checkpoints older than this many hours (0 = keep everything) to keep the database
# small; checked at server start and every CHECKPOINT_CLEANUP_INTERVAL_MINUTES. A deleted scan can
# no longer be resumed; its report and audit record are kept.
CHECKPOINT_RETENTION_HOURS=24
CHECKPOINT_CLEANUP_INTERVAL_MINUTES=60
SUBAGENT_CHECKPOINT_DB_PATH=./data/checkpoints/subagents.sqlite
# AES encryption at rest for the SQLite checkpoints. They hold the scan request
# (target JWT / login password), the target session after sign-in and
# human-in-the-loop answers (MFA codes). Any secret string; keep it stable
# (paused/crashed runs cannot be resumed without it). Empty = plaintext + a warning.
CHECKPOINT_ENCRYPTION_KEY=
REPORTS_DIR=./data/reports

# ---- API authentication (JWT, RS256) + RBAC ----
# Every HTTP/WebSocket call except /healthz and /auth/* needs
# "Authorization: Bearer <access token>". Create the key pair once with
#   uv run pentest-auth keys          (or just run: uv run python scripts/get_token.py)
# keys/ is gitignored; never commit the private key. AUTH_ENABLED=false is for local testing only.
AUTH_ENABLED=true
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=pentest-agent
JWT_AUDIENCE=pentest-agent-api
# Access token lifetime; the server renews it automatically when less than
# JWT_AUTO_REFRESH_BEFORE_MINUTES is left (X-New-Access-Token header / "token_refreshed").
JWT_ACCESS_TTL_MINUTES=60
JWT_AUTO_REFRESH_BEFORE_MINUTES=10
# Max session length from sign-in (refresh tokens and auto refresh stop after this).
JWT_REFRESH_TTL_MINUTES=1440
JWT_LEEWAY_SECONDS=30
# Client that signs in at POST /auth/token. Generate a secret: uv run pentest-auth secret
AUTH_CLIENT_ID=pentest-client
AUTH_CLIENT_SECRET=
# RBAC roles of that client: viewer (read reports), scanner (+ run quick/standard scans),
# admin (+ aggressive/auth_deep, authenticated target testing, any session).
AUTH_CLIENT_ROLES=admin
# More clients with their own roles: uv run pentest-auth add-client --id NAME --roles scanner
AUTH_CLIENTS_FILE=./keys/clients.json

# ---- Logging ----
# Warnings and errors (with tracebacks) are also written to this rotating file
# (5 MB x 5 backups). Empty disables the file. Console output is unchanged.
LOG_FILE=./data/logs/pentest-agent.log
LOG_FILE_LEVEL=WARNING

# ---- Sandbox: code & content check, uploaded code (Kubernetes Jobs, no Docker) ----
# Backend source, fetched website text and the operator's code (zip / files / git) are analysed in a
# Kubernetes Job (scopeguard/k8s.py): stock Python image, analyzer code from an immutable
# sha256-named ConfigMap (read-only), deny-all NetworkPolicy, non-root, read-only root fs,
# no service-account token. Nothing is built and Docker is never used.
# One-time cluster setup:  kubectl apply -f k8s/sandbox.yaml
#   SANDBOX_BACKEND=kubernetes      -> Kubernetes Job per check/upload (default)
#   SANDBOX_BACKEND=process         -> always the local Python process sandbox (skip Kubernetes)
#   Kubernetes when usable, otherwise (no kubectl / Docker / kind / Calico, or the cluster is down)
#   the Python process sandbox, automatically; a note in the report says why.
#   Auto-check at start: no kubectl on the machine -> this run uses the process sandbox by itself
#   (no bring-up, no retries). This file is never changed by the scanner.

#   SANDBOX_CHECK_ENABLED=false     -> skip the code/content check entirely; the in-process
#                                      JavaScript SAST step runs instead.
SANDBOX_CHECK_ENABLED=true
SANDBOX_BACKEND=kubernetes
CODECHECK_TIMEOUT_SECONDS=180
# Minimum memory (MB); the limit is sized from the content (below).
CODECHECK_MEMORY_MB=512
# Folders a scan's "source_path" must sit inside (comma-separated; empty = any folder).
CODECHECK_SOURCE_ROOTS=
# Memory = MULTIPLIER x content size; after an out-of-memory crash ONE retry with
# RETRY_MULTIPLIER x that resumes from the checkpoint (finished files are not re-run).
SANDBOX_MEMORY_MULTIPLIER=5
SANDBOX_RETRY_MEMORY_MULTIPLIER=10
SANDBOX_MEMORY_FLOOR_MB=256
SANDBOX_MEMORY_CEILING_MB=4096
# Kubernetes Job settings (kubectl uses KUBECONFIG / in-cluster config unless set here).
K8S_NAMESPACE=scopeguard-sandbox
# Stock image; pin a digest in production, e.g. python:3.12-slim@sha256:<digest>
K8S_IMAGE=python:3.12-slim
K8S_IMAGE_PULL_POLICY=IfNotPresent
K8S_CONTEXT=
K8S_KUBECONFIG=
# Optional stronger isolation: gvisor / kata (a RuntimeClass installed in the cluster)
K8S_RUNTIME_CLASS=
K8S_CPU=1
# Use Kubernetes only when the scopeguard-deny-all NetworkPolicy exists and blocks traffic
# (otherwise: the Python process sandbox).
K8S_REQUIRE_NETWORK_POLICY=true
# Prove it is ENFORCED: a probe Job must fail to reach the Kubernetes API and the internet.
# Some CNIs (kind default, Docker Desktop) ignore NetworkPolicy; then the cluster counts as not
# ready and scans use the Python process sandbox (Calico / Cilium enforce it).
K8S_VERIFY_NETWORK_ISOLATION=true
# Bring the sandbox up at server start (background): start the stopped kind node
# (K8S_KIND_CLUSTER, host only), apply k8s/sandbox.yaml if the namespace is missing, ship the
# analyzer ConfigMap, run the isolation probe. Anything failing: Python process sandbox.
# By hand: uv run python -m scopeguard.k8s --bootstrap
K8S_AUTO_START=true
K8S_KIND_CLUSTER=scopeguard
K8S_AUTO_APPLY_MANIFESTS=true
# With kubectl present the bring-up finishes before the server / console starts (at most this long).
K8S_STARTUP_WAIT_SECONDS=180
# While Kubernetes is not ready, retry the bring-up this often (s) in the background;
# scans and the console switch to Kubernetes Jobs once it is. 0 = only at start-up.
K8S_RETRY_SECONDS=60
# No kind cluster at all (deleted, Docker reset): create it from k8s/kind-calico.yaml and
# install the pinned Calico (SHA-256 checked) on start-up. Needs the kind CLI. First run: minutes.
K8S_AUTO_CREATE_CLUSTER=true

# ---- Source code for the scan's code SAST step (graph nodes code_source -> code_sast) ----
# Admin only (scan:source). Code is analysed as the scan's code SAST step (website + code, or code
# only, chosen in the New scan card / scan_scope):
# code files or a .zip (console source-code dialog, POST /api/uploads[/files], MCP upload_code)
# or a public .git link. Names, MIME type and zip signature are checked; the code is unpacked and
# analysed only inside the sandbox Job (SAST, XSS, IDOR, injection, SSRF, secrets, supply chain,
# IaC, archive safety, PEP 8 + ruff lint rules for Python) with recommendations per rule, all in
# the scan's one report. Python only for now: other files are marked "partial coverage".
# Executables / batch scripts (.exe, .bat, .cmd) are listed as warnings with a red flag; shell
# scripts (.sh) only as a note. They are never run. The upload folder is deleted after analysis.
CODE_UPLOAD_ENABLED=true
CODE_UPLOAD_DIR=./data/uploads
CODE_UPLOAD_MAX_MB=50
# Uploads are deleted right after their analysis; this TTL only covers failed or unused ones.
CODE_UPLOAD_TTL_HOURS=24
# Pre-guardrail: uploads per user per hour (then 429). Other pre-guardrails (always on):
# authorization confirmed, archive integrity (SHA-256), metadata-only archive preflight,
# sandbox ready incl. the Kubernetes isolation probe. Post-guardrails clean every result.
CODE_UPLOAD_MAX_PER_HOUR=20
CODE_UPLOAD_TIMEOUT_SECONDS=300
# Source code at the SAST step (human in the loop): with ask_for_code the scan pauses in its
# code_source step and asks for code files, a .zip or a git link; code_sast analyses it in the
# sandbox. Code is analysed as the scan's code SAST step (with the website, or code only).
CODE_FILES_MAX_COUNT=500
CODE_INPUT_TIMEOUT_SECONDS=600
# Human in the loop before any request (graph choose_scope, ask_scan_scope): how long the scan waits
# for "website + code / website only / code only" before it uses the default.
SCOPE_INPUT_TIMEOUT_SECONDS=300
# Git links: only .git clone links of public repositories on these hosts (optional branch/tag).
# Before cloning: network policy, then git ls-remote (reachable, public, not empty, ref exists; one
# retry on a transient error). Shallow clone without credentials, submodules, LFS, hooks or
# redirects, size- and time-capped (git must be installed).
GIT_ENABLED=true
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
GIT_CLONE_TIMEOUT_SECONDS=120
GIT_CLONE_MAX_MB=200
# Max times any agent node (and sub-agent) may run per scan (safety stop).
AGENT_MAX_ITERATIONS=5
# Custom probes: a probe that times out or loses its connection is retried (tenacity, exponential
# backoff 2, 4, 8, 16 s, at least the target's last Retry-After; 25 s timeout on retries), up to
# PROBE_MAX_ATTEMPTS tries; all retries of one scan take at most PROBE_RETRY_BUDGET_SECONDS.
PROBE_MAX_ATTEMPTS=5
PROBE_RETRY_BUDGET_SECONDS=180
# Active file-upload testing: POST benign, disguised marker files to detected upload
# forms (aggressive/auth_deep profile + admin scan:upload permission only).
ENABLE_UPLOAD_TESTS=true

# ---- Network policy ----
# Link-local / cloud-metadata (169.254.169.254, fd00:ec2::254, ...), multicast and
# reserved addresses are always refused, at the pre-scan check AND on every
# connection (DNS answers are re-checked, so DNS rebinding cannot reach them).
# true also refuses loopback and private networks (localhost, 10/8, 172.16/12,
# 192.168/16, 100.64/10, fc00::/7). Keep false to scan local dev apps / the demo target.
BLOCK_PRIVATE_TARGETS=false

# ---- Human-in-the-loop sign-in (SSO / MFA) ----
# A scan request with "interactive_auth": true (admin, scan:authenticated) pauses
# (LangGraph interrupt) when the target uses SSO or asks for an MFA code; the
# operator signs in or enters the code in the console / ws_client. With no answer
# within this many seconds the scan continues unauthenticated.
AUTH_INPUT_TIMEOUT_SECONDS=300

# ---- Audit log ----
# One tamper-evident record per finished scan (completed, refused, failed,
# disconnected, cached or rejected), written by the graph's last node "audit"
# (and by the server for requests that never reach the graph). Hash-chained JSONL.
# Check it: uv run pentest-audit verify --reports-dir data/reports
AUDIT_LOG_PATH=./data/audit/audit.jsonl
# Separate trail for code uploads + the code sandbox: uploads, refusals, pre/post guardrails,
# every sandbox attempt (Job, memory, OOM), results. Same HMAC key; verify with
# `uv run pentest-audit --trail code verify`.
CODE_AUDIT_LOG_PATH=./data/audit/code_audit.jsonl
# Optional HMAC key: records then cannot be forged or rewritten without it.
# Generate one with: uv run pentest-auth secret   (keep it secret and stable)
AUDIT_HMAC_KEY=

# ---- Scan limits ----
MAX_CRAWL_PAGES=60

# ---- Caching ----
# Reuse identical scans, probe results and LLM answers for this many seconds (0 disables).
CACHE_TTL_SECONDS=300

# ---- LLM prompts ----
# Folder holding the prompt files (gitignored; see README "LLM prompts").
# Missing files make that LLM step fall back to its deterministic output.
PROMPTS_DIR=./prompts

# ---- Backend rate limit (per client IP; 0 disables) ----
# Exceeding it returns HTTP 429 with Retry-After.
HTTP_RATE_LIMIT_PER_MINUTE=120

# ---- API management: server-wide admission queues ----
# At most *_MAX_ACTIVE run at once (all clients together); up to *_MAX_QUEUE more
# wait in FIFO order; beyond that: 429 "Too many requests ... try again after some time"
# (WebSocket: error + close code 4429). Queued WebSocket clients get
# {"type": "queued", "position": n, ...} when their position changes and every
# QUEUE_UPDATE_SECONDS. HTTP responses carry X-Queue-Position / X-Queue-Wait-Seconds.
# GET /healthz shows the current counts. *_MAX_ACTIVE=0 disables that queue.
WS_MAX_ACTIVE=1
WS_MAX_QUEUE=50
HTTP_MAX_ACTIVE=1
HTTP_MAX_QUEUE=50
QUEUE_UPDATE_SECONDS=5
# Longest an HTTP request waits in the queue before it gets a 429.
HTTP_QUEUE_TIMEOUT_SECONDS=60

# ---- WebSocket server ----
WS_HOST=127.0.0.1
WS_PORT=8765
# CORS: exact origins (scheme://host[:port], comma-separated) whose browser pages may call the
# API and open /ws, e.g. http://localhost:5173. Empty = same-origin only; '*' and 'null' are refused.
CORS_ALLOWED_ORIGINS=

# ---- Agent integrations: MCP + A2A (see src/pentest_agent/mcp_server/CLAUDE.md, a2a_server/CLAUDE.md) ----
# Both start with `uv run pentest-agent`: MCP over Streamable HTTP at /mcp and A2A
# JSON-RPC at /a2a (agent card: /.well-known/agent-card.json, public). Calls need an
# API JWT and run as its subject/roles. stdio MCP (`uv run scopeguard-mcp`, .mcp.json)
# is started by the coding assistant and runs as MCP_ROLE.
MCP_HTTP_ENABLED=true
A2A_ENABLED=true
# Only the operator decides what agents may scan: comma-separated hosts (any port)
# or host:port. Empty = only the built-in demo target.
MCP_ALLOWED_TARGETS=
A2A_ALLOWED_TARGETS=
# RBAC role for stdio MCP: scanner (quick/standard + reports) or admin
# (aggressive, credentials, uploads, audit log).
MCP_ROLE=scanner
# MCP tools to switch off, comma-separated (not listed, not callable; HTTP and stdio).
# e.g. cancel_scan,verify_audit_log. Names: scan_policy, start_scan, start_demo_scan, get_scan,
# cancel_scan, list_scans, list_reports, get_report, verify_audit_log, upload_code.
# Empty = all on.
MCP_DISABLED_TOOLS=
# Largest .zip (base64) or set of code files an agent may send to the MCP upload_code tool.
MCP_MAX_UPLOAD_MB=10
# Chatbot tools to switch off, comma-separated (the chat agent will not use them).
# Names: scan_policy, start_scan, start_demo_scan, cancel_scan, list_scans, list_reports,
# get_report, watch_scan. Empty = all on. Tools disabled on the server (MCP_DISABLED_TOOLS)
# are never offered either.
CHATBOT_DISABLED_TOOLS=
# Authenticated scans use named credential profiles; the agent sends only the name.
# Manage: uv run scopeguard-mcp credentials add|list|remove (secrets are prompted for).
SCAN_CREDENTIALS_FILE=./keys/scan_credentials.json
# Accept raw JWT/password values in tool calls (they land in the agent's transcript).
MCP_ALLOW_INLINE_CREDENTIALS=false
A2A_ALLOW_INLINE_CREDENTIALS=false
# URL other agents use to reach this server (agent card). Empty = from WS_HOST/WS_PORT.
PUBLIC_BASE_URL=
