# ScopeGuard MCP chatbot settings. Copy to .env (gitignored) and adjust.
# Precedence: environment variables > this .env > the repo's main .env.

# --- Chat model (Groq) -------------------------------------------------------
# GROQ_API_KEY, GROQ_MODEL and GROQ_REASONING_EFFORT come only from the repo's main .env
# (the same key and model as the scanner). Do not set them here: they would be ignored.
# Reply budget. Groq's on_demand tier allows 8,000 tokens per request (prompt + reply).
CHATBOT_MAX_TOKENS=3000

# --- Allowed targets ----------------------------------------------------------
# Hosts you own or may test, comma separated (any number), e.g.
#   CHATBOT_ALLOW=syslab-blond.vercel.app,staging.example.com,localhost:3000
# The UI (chatbots/ui/serve_ui.py, also in Docker) starts with these and lets you add or remove
# more. The console chatbot starts a private scanner that allowlists exactly these.
CHATBOT_ALLOW=
# true: the scanner skips its own LLM steps (executive summary, probe plan) - faster.
# The chat agent still uses the LLM.
CHATBOT_NO_SCANNER_LLM=false

# --- Console chatbot without CHATBOT_ALLOW -------------------------------------
# The pentest-agent it connects to (its own .env decides that allowlist).
SCOPEGUARD_URL=http://127.0.0.1:8765

# --- Sign-in (API JWT signed with the scanner's key) -------------------------------
# Roles in the chatbot's token: scanner (quick/standard) or admin (also credential profiles).
CHATBOT_ROLES=scanner
# Paths are relative to the repo root. The private key never leaves your machine.
# JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
# JWT_ISSUER=pentest-agent
# JWT_AUDIENCE=pentest-agent-api
